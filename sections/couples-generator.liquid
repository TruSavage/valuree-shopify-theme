{% assign active_member = false %}{% if customer and customer.metafields.valuree.membership_status.value == 'active' %}{% assign active_member = true %}{% endif %}
<section id="date-generator" class="section generator-shell" data-valuree-generator data-endpoint="{{ section.settings.api_endpoint | escape }}"><div class="page-width"><div class="section-heading"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.copy }}</p></div>{% if active_member or request.design_mode %}<div class="generator-layout"><form class="preference-form">
{% assign moods = 'Romantic,Playful,Adventurous,Relaxed' | split: ',' %}{% assign budgets = '$0,$25,$50,$100+' | split: ',' %}{% assign places = 'Stay In,Go Out,Either' | split: ',' %}{% assign times = '1 hour,2–3 hours,Half day,All day' | split: ',' %}
<fieldset><legend>What is the mood?</legend><div class="choice-grid">{% for value in moods %}<label><input type="radio" name="mood" value="{{ value }}" required><span>{{ value }}</span></label>{% endfor %}</div></fieldset>
<fieldset><legend>What is the budget?</legend><div class="choice-grid">{% for value in budgets %}<label><input type="radio" name="budget" value="{{ value }}" required><span>{{ value }}</span></label>{% endfor %}</div></fieldset>
<fieldset><legend>Stay in or go out?</legend><div class="choice-grid choice-grid--three">{% for value in places %}<label><input type="radio" name="place" value="{{ value }}" required><span>{{ value }}</span></label>{% endfor %}</div></fieldset>
<fieldset><legend>How much time?</legend><div class="choice-grid">{% for value in times %}<label><input type="radio" name="time" value="{{ value }}" required><span>{{ value }}</span></label>{% endfor %}</div></fieldset>
<button class="button button--primary generator-submit" type="submit">Find our date</button><p class="generator-status" data-generator-status role="status">Answers are sent securely when matching is connected.</p></form>
<aside class="generator-result" data-generator-result hidden aria-live="polite"><p class="eyebrow">Your Valurée match</p><div class="generator-result__heart">♥</div><h3 data-result-title></h3><p data-result-copy></p><strong data-result-meta></strong><div class="generator-result__actions"><button class="button button--ghost" type="button">Save date</button><button class="button button--ghost" type="button">Share</button></div></aside></div>{% else %}<div class="member-gate"><span class="member-gate__icon">♥</span><p class="eyebrow">Premium members only</p><h3>Your next favorite date is waiting.</h3><p>Join Valurée Premium to match privately with your partner, unlock personalized dates, and save every favorite.</p><a class="button button--primary" href="#membership">Unlock for $9.99/month</a>{% unless customer %}<a class="member-gate__login" href="{{ routes.account_login_url }}">Already a member? Sign in</a>{% endunless %}</div>{% endif %}</div></section>
{% schema %}{"name":"Couples generator","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Your night, matched"},{"type":"text","id":"heading","label":"Heading","default":"Tell us what tonight needs"},{"type":"textarea","id":"copy","label":"Text","default":"Choose your preferences. In the full couples flow, your partner answers privately before Valurée reveals the match."},{"type":"text","id":"api_endpoint","label":"Secure app proxy endpoint","info":"Set after the Valurée backend is installed. Example: /apps/valuree"}],"presets":[{"name":"Couples generator"}]}{% endschema %}
