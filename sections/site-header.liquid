<header class="site-header">
  <div class="page-width site-header__inner">
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">Valur<span>ée</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% else %}<a href="#how-it-works">How it works</a><a href="#experiences">Date ideas</a><a href="#about">About</a>{% endfor %}
    </nav>
    <div class="header-actions"><a class="button button--primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a></div>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu" aria-label="Open menu">☰</button>
  </div>
  <nav id="MobileMenu" class="mobile-nav" data-mobile-menu hidden aria-label="Mobile navigation">
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% else %}<a href="#how-it-works">How it works</a><a href="#experiences">Date ideas</a><a href="#about">About</a>{% endfor %}
    <a class="button button--primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
  </nav>
</header>
{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu"},{"type":"text","id":"cta_label","label":"Button label","default":"Plan a date"},{"type":"url","id":"cta_link","label":"Button link"}]}{% endschema %}
