<section class="section faq-section"><div class="page-width faq-layout">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, copy: section.settings.copy %}<div class="faq-list">{% for block in section.blocks %}<details class="faq-item" {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Questions, answered"},{"type":"text","id":"heading","label":"Heading","default":"Before you join"},{"type":"richtext","id":"copy","label":"Intro","default":"<p>Clear details about membership and the Valurée experience.</p>"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"What is included in Valurée Premium?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Premium is designed to include private partner matching, personalized recommendations, saved dates, history, and future member features as they launch.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question","settings":{"question":"How much does membership cost?","answer":"<p>Valurée Premium is $9.99 per month. Billing terms are shown before checkout.</p>"}},{"type":"question","settings":{"question":"Can my partner see my answers?","answer":"<p>No. The platform is designed to show both partners a shared result without exposing either person’s raw answers.</p>"}},{"type":"question","settings":{"question":"Can I cancel?","answer":"<p>Yes. Final cancellation timing and access rules will be stated in the owner-approved Subscription and Cancellation Policies before launch.</p>"}},{"type":"question","settings":{"question":"Is Valurée relationship therapy?","answer":"<p>No. Valurée is a recreational date-planning platform, not therapy, diagnosis, or professional relationship advice.</p>"}}]}]}{% endschema %}
