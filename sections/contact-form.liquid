<section class="section page-main"><div class="page-width contact-layout"><div><p class="eyebrow">Contact Valurée</p><h1>How can we help?</h1><p>Questions about membership, privacy, or the Valurée experience? Send us a note.</p></div>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p class="form-success" tabindex="-1">{{ 'contact.form.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">{{ 'contact.form.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name"><label for="ContactEmail">{{ 'contact.form.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required><label for="ContactMessage">{{ 'contact.form.message' | t }}</label><textarea id="ContactMessage" name="contact[body]" rows="7" required></textarea><button class="button button--primary" type="submit">{{ 'contact.form.send' | t }}</button>{% endform %}</div></section>
{% schema %}{"name":"Contact form","settings":[]} {% endschema %}
