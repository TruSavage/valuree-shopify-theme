<section id="membership" class="section membership-section"><div class="page-width membership-grid"><div class="membership-story"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.copy }}</p><div class="membership-quote"><span>“</span><p>More quality time. Less time deciding.</p></div></div><article class="price-card"><div class="price-card__top"><span>VALURÉE PREMIUM</span><span class="price-badge">One simple plan</span></div><div class="price"><strong>$9.99</strong><span>/ month</span></div><p>Everything the two of you need for better date nights.</p><ul><li>Unlimited personalized date matches</li><li>Private partner answers and couple code</li><li>Hundreds of curated date ideas</li><li>Save favorites and revisit your history</li><li>New date collections every month</li><li>Cancel anytime</li></ul><a class="button button--primary price-card__button" href="{{ section.settings.join_link }}">{{ section.settings.join_label }}</a><small>Recurring monthly membership. Secure checkout through Shopify.</small></article></div></section>
{% schema %}{"name":"Membership pricing","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"One membership. More moments."},{"type":"text","id":"heading","label":"Heading","default":"Make date night a habit—not a hassle."},{"type":"textarea","id":"copy","label":"Text","default":"Valurée Premium gives you a private space to discover what you both want, plan meaningful time together, and keep the memories going."},{"type":"text","id":"join_label","label":"Button label","default":"Start Valurée Premium"},{"type":"url","id":"join_link","label":"Subscription product link"}],"presets":[{"name":"Membership pricing"}]}{% endschema %}
