{% if section.settings.show %}<aside class="announcement" aria-label="Membership announcement"><div class="page-width announcement__inner"><p>{{ section.settings.text }}</p><a href="{{ section.settings.link | default: '#membership' }}">{{ section.settings.link_label }}</a></div></aside>{% endif %}
{% schema %}{"name":"Announcement bar","settings":[{"type":"checkbox","id":"show","label":"Show announcement","default":true},{"type":"text","id":"text","label":"Text","default":"Valurée Premium — personalized date nights for two"},{"type":"text","id":"link_label","label":"Link label","default":"Join for $9.99/month"},{"type":"url","id":"link","label":"Link"}]}{% endschema %}
