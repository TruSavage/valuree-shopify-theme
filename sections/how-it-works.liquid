<section id="how-it-works" class="section"><div class="page-width"><div class="section-heading"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.copy }}</p></div><div class="steps">{% for block in section.blocks %}<article class="step" {{ block.shopify_attributes }}><span class="step__number">{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"How it works","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Made for two"},{"type":"text","id":"heading","label":"Heading","default":"Your best date night in three steps"},{"type":"textarea","id":"copy","label":"Text","default":"You each bring your preferences. Valurée finds the overlap—and makes it feel effortless."}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title","default":"Answer privately"},{"type":"textarea","id":"copy","label":"Text","default":"Share what you're in the mood for without influencing each other's answers."}]}],"max_blocks":3,"presets":[{"name":"How it works","blocks":[{"type":"step"},{"type":"step","settings":{"title":"Find the overlap","copy":"We balance mood, energy, budget, time, and place to find ideas that fit you both."}},{"type":"step","settings":{"title":"Make a memory","copy":"Choose your favorite match, save it, and spend less time deciding what to do."}}]}]}{% endschema %}
