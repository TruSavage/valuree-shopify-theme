<section class="hero hero--couple">
  <div class="hero-photo"{% if section.settings.image != blank %} style="--hero-image:url('{{ section.settings.image | image_url: width: 2400 }}')"{% else %} style="--hero-image:url('https://cdn.shopify.com/s/files/1/0749/8717/6072/files/valuree-couple-hero.png?v=1787557387')"{% endif %} role="img" aria-label="{{ section.settings.image_alt | escape }}"></div>
  <div class="hero-shade"></div>
  <div class="page-width hero-couple__content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="display">{{ section.settings.heading }} <span class="gradient-text">{{ section.settings.accent }}</span></h1>
    <p class="hero__copy">{{ section.settings.copy }}</p>
    <div class="hero__actions"><a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a><a class="button button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div>
    <div class="couple-promise"><span aria-hidden="true">♥</span><p><strong>Two people. One plan you both want.</strong><br>Your answers stay private until the match is ready.</p></div>
  </div>
  <div class="page-width"><div class="hero-date-note"><span>Tonight could be</span><strong>{{ section.settings.card_title }}</strong><small>{{ section.settings.card_copy }}</small></div></div>
</section>
{% schema %}{"name":"Couple hero","settings":[{"type":"image_picker","id":"image","label":"Couple photo"},{"type":"text","id":"image_alt","label":"Image description","default":"A couple enjoying an intimate date night together"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Date night, chosen together"},{"type":"text","id":"heading","label":"Heading","default":"Fall for each other."},{"type":"text","id":"accent","label":"Accent heading","default":"Again and again."},{"type":"textarea","id":"copy","label":"Text","default":"Valurée turns both of your moods into thoughtful dates that bring you closer—without the endless “what do you want to do?” conversation."},{"type":"text","id":"primary_label","label":"Primary button","default":"Plan our date"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"How it works"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"card_title","label":"Date note title","default":"Candlelight & Cocktails"},{"type":"textarea","id":"card_copy","label":"Date note text","default":"Romantic · 2–3 hours · Made for two"}],"presets":[{"name":"Couple hero"}]}{% endschema %}
