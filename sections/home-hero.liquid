<section class="hero"><div class="page-width hero__grid"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 class="display">{{ section.settings.heading }} <span class="gradient-text">{{ section.settings.accent }}</span></h1><p class="hero__copy">{{ section.settings.copy }}</p><div class="hero__actions"><a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a><a class="button button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div><div class="hero__proof"><span><strong>Personalized</strong> to both partners</span><span><strong>Private</strong> preferences</span><span><strong>Zero</strong> planning stress</span></div></div><div class="hero-card" aria-label="Example date recommendation"><span class="hero-card__tag">TONIGHT'S MATCH</span><div class="hero-card__heart">♥</div><h2>{{ section.settings.card_title }}</h2><p>{{ section.settings.card_copy }}</p><div class="hero-card__meta"><span>$$</span><span>2–3 hours</span><span>Go out</span></div></div></div></section>
{% schema %}{"name":"Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Dates that feel like you"},{"type":"text","id":"heading","label":"Heading","default":"Less planning."},{"type":"text","id":"accent","label":"Accent heading","default":"More us."},{"type":"textarea","id":"copy","label":"Text","default":"Valurée turns both of your moods, budgets, and preferences into date nights you'll genuinely look forward to."},{"type":"text","id":"primary_label","label":"Primary button","default":"Find our date"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"See how it works"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"card_title","label":"Card title","default":"Candlelight & Cocktails"},{"type":"textarea","id":"card_copy","label":"Card text","default":"Dress up, find a cozy corner, and order something neither of you has tried."}],"presets":[{"name":"Hero"}]}{% endschema %}
