<section class="section trust-section"><div class="page-width trust-card"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.copy }}</p></div><div class="trust-grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span>{% render 'icon-heart' %}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Privacy and trust","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Built for trust"},{"type":"text","id":"heading","label":"Heading","default":"Your relationship is personal. Your experience should be too."},{"type":"textarea","id":"copy","label":"Text","default":"Valurée is being designed around private answers, clear controls, and secure member access—not public profiles or social pressure."}],"blocks":[{"type":"trust","name":"Trust point","settings":[{"type":"text","id":"title","label":"Title","default":"Private answers"},{"type":"textarea","id":"copy","label":"Text","default":"Partners receive a shared match, not each other’s raw responses."}]}],"max_blocks":3,"presets":[{"name":"Privacy and trust","blocks":[{"type":"trust"},{"type":"trust","settings":{"title":"Member-only access","copy":"Personalized tools require a verified active membership."}},{"type":"trust","settings":{"title":"Clear choices","copy":"Manage invitations, couple settings, privacy, billing, and account deletion."}}]}]}{% endschema %}
