<section class="section final-cta"><div class="page-width final-cta__card"><span class="final-cta__heart">{% render 'icon-heart' %}</span><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.copy }}</p><a class="button button--primary" href="{{ section.settings.link | default: '#membership' }}">{{ section.settings.label }}</a><small>$9.99/month · Monthly recurring membership</small></div></section>
{% schema %}{"name":"Final membership CTA","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Your next date starts here"},{"type":"text","id":"heading","label":"Heading","default":"Make more room for the two of you."},{"type":"textarea","id":"copy","label":"Text","default":"Spend less time searching and more time making memories together."},{"type":"text","id":"label","label":"Button label","default":"Start Your Membership"},{"type":"url","id":"link","label":"Membership link"}],"presets":[{"name":"Final membership CTA"}]}{% endschema %}
