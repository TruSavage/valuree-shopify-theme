<section class="section benefits-section"><div class="page-width">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, copy: section.settings.copy %}<div class="benefit-grid">{% for block in section.blocks %}<article class="benefit-card" {{ block.shopify_attributes }}><span class="benefit-card__number">0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Member benefits","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Included with Premium"},{"type":"text","id":"heading","label":"Heading","default":"More than a date generator"},{"type":"richtext","id":"copy","label":"Text","default":"<p>A private home for planning, remembering, and making more time for each other.</p>"}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"title","label":"Title","default":"Personalized matching"},{"type":"textarea","id":"copy","label":"Text","default":"Recommendations shaped by both partners’ real preferences."}]}],"max_blocks":6,"presets":[{"name":"Member benefits","blocks":[{"type":"benefit"},{"type":"benefit","settings":{"title":"Private couple space","copy":"Connect with one secure partner invitation and keep check-ins private."}},{"type":"benefit","settings":{"title":"Saved dates & history","copy":"Build a collection of favorites and revisit the nights you loved."}},{"type":"benefit","settings":{"title":"Date remix","copy":"Make a recommendation cheaper, shorter, calmer, or more romantic."}},{"type":"benefit","settings":{"title":"Surprise mode","copy":"Keep the full plan private while sharing only what your partner needs."}},{"type":"benefit","settings":{"title":"Fresh inspiration","copy":"Explore curated categories without pretending live venue data is available."}}]}]}{% endschema %}
