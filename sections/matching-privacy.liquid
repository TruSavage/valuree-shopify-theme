<section class="section privacy-match"><div class="page-width privacy-match__grid"><div>{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, copy: section.settings.copy %}<div class="privacy-points">{% for block in section.blocks %}<div class="privacy-point" {{ block.shopify_attributes }}><span>{% render 'icon-heart' %}</span><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p></div></div>{% endfor %}</div></div><div class="private-preview" aria-label="Private matching preview"><div class="partner-orb">You<span>Ready</span></div><div class="match-line"><span></span><strong>Private match</strong><span></span></div><div class="partner-orb partner-orb--two">Partner<span>Ready</span></div><p>Valurée compares the overlap—not each other’s answers.</p></div></div></section>
{% schema %}{"name":"Private matching","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Private by design"},{"type":"text","id":"heading","label":"Heading","default":"Honest answers. Shared results."},{"type":"richtext","id":"copy","label":"Text","default":"<p>Each partner checks in separately, so both people can answer without pressure or influence.</p>"}],"blocks":[{"type":"point","name":"Privacy point","settings":[{"type":"text","id":"title","label":"Title","default":"Separate check-ins"},{"type":"textarea","id":"copy","label":"Text","default":"Your individual preferences are never shown to your partner."}]}],"max_blocks":3,"presets":[{"name":"Private matching","blocks":[{"type":"point"},{"type":"point","settings":{"title":"Balanced recommendations","copy":"The result includes thoughtful elements both partners are likely to enjoy."}},{"type":"point","settings":{"title":"No awkward compromise","copy":"See why a date fits without revealing who chose what."}}]}]}{% endschema %}
