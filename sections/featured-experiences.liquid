<section id="experiences" class="section"><div class="page-width"><div class="section-heading"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.copy }}</p></div><div class="experience-grid">{% for block in section.blocks %}<article class="experience" {{ block.shopify_attributes }}><span class="experience__icon" aria-hidden="true">{{ block.settings.icon }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Featured experiences","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Whatever the mood"},{"type":"text","id":"heading","label":"Heading","default":"A date for every version of you"},{"type":"textarea","id":"copy","label":"Text","default":"Quiet nights, spontaneous adventures, and everything in between."}],"blocks":[{"type":"experience","name":"Experience","settings":[{"type":"text","id":"icon","label":"Icon","default":"✦"},{"type":"text","id":"title","label":"Title","default":"Stay-in magic"},{"type":"textarea","id":"copy","label":"Text","default":"Low-pressure ideas that make home feel completely new."}]}],"max_blocks":3,"presets":[{"name":"Featured experiences","blocks":[{"type":"experience"},{"type":"experience","settings":{"icon":"♢","title":"Go-out energy","copy":"Restaurants, hidden gems, and playful plans worth getting dressed for."}},{"type":"experience","settings":{"icon":"☾","title":"Something unexpected","copy":"Fresh experiences that help you discover a new side of each other."}}]}]}{% endschema %}
