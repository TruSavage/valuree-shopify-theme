<section class="section examples-section"><div class="page-width">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, copy: section.settings.copy, align: 'center' %}<div class="example-grid">{% for block in section.blocks %}<article class="date-example" {{ block.shopify_attributes }}><div class="date-example__visual"><span>{{ block.settings.category }}</span><strong>{{ block.settings.score }}%</strong></div><div class="date-example__body"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p><div><span>{{ block.settings.cost }}</span><span>{{ block.settings.time }}</span><span>{{ block.settings.place }}</span></div></div></article>{% endfor %}</div><p class="sample-label">Sample recommendations for demonstration only.</p></div></section>
{% schema %}{"name":"Example results","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Dates with intention"},{"type":"text","id":"heading","label":"Heading","default":"A recommendation you can actually picture"},{"type":"richtext","id":"copy","label":"Text","default":"<p>Every result is designed to be practical, flexible, and easy to personalize.</p>"}],"blocks":[{"type":"date","name":"Example date","settings":[{"type":"text","id":"category","label":"Category","default":"ROMANTIC · RELAXED"},{"type":"range","id":"score","label":"Example score","min":70,"max":99,"step":1,"default":92},{"type":"text","id":"title","label":"Title","default":"Dinner by Candlelight"},{"type":"textarea","id":"copy","label":"Text","default":"Cook one new dish together, dress the table, and end with a question card."},{"type":"text","id":"cost","label":"Cost","default":"$25–$50"},{"type":"text","id":"time","label":"Time","default":"2–3 hours"},{"type":"text","id":"place","label":"Place","default":"Stay In"}]}],"max_blocks":3,"presets":[{"name":"Example results","blocks":[{"type":"date"},{"type":"date","settings":{"category":"PLAYFUL · ADVENTUROUS","score":88,"title":"City Photo Challenge","copy":"Take a playful walk with five photo prompts and a dessert finish.","cost":"$0–$25","time":"2 hours","place":"Go Out"}},{"type":"date","settings":{"category":"CALM · ROMANTIC","score":95,"title":"Slow Sunday Reset","copy":"Coffee, a shared playlist, and an unhurried neighborhood walk.","cost":"$0–$25","time":"Half day","place":"Either"}}]}]}{% endschema %}
